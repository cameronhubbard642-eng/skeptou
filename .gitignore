# Build outputs
node_modules/
public/
.wrangler/
dist/
out/

# Environment / secrets
.env
.env.local
.env.*.local
*.env.local

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Claude Code worktree state (tied to home-dir git; not part of this repo)
.claude/

# Auto-memory journal (personal; not for version control)
.auto-memory/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Quartz build cache
.quartz-cache/

# Logs
*.log
npm-debug.log*

# LaTeX templates — canonical location is agora/templates/; not tracked here
assets/tex_templates/

# archive/ holds data pulled off live infrastructure — D1 dumps in any format
# (.sql, .json, …) carrying personal data: phronesis commitments, tasks,
# projects, opportunities, audit log. Kept locally only; NEVER committed.
# Everything under archive/ is ignored except its top-level README.
# See archive/README.md.
archive/**
!archive/README.md
