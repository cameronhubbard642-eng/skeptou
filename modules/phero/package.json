{
  "name": "phero-skeptou",
  "version": "0.1.0",
  "private": true,
  "description": "Phero -- document sharing interface for skeptou.com",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "migrate:remote": "wrangler d1 migrations apply skeptou-phero --remote",
    "migrate:local": "wrangler d1 migrations apply skeptou-phero --local"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.0.0"
  }
}
