# Cloudflare Pages _headers -- strategia.skeptou.com
# Private access-gated subdomain: no public caching, no framing.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; object-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block

/*.html
  Cache-Control: private, no-store, no-cache

/api/*
  Cache-Control: no-store, private

/viewer.css
  Cache-Control: private, max-age=3600

/viewer.js
  Cache-Control: private, max-age=3600

/fonts/*
  Cache-Control: private, max-age=86400
